{
  "name": "techlith-session-7-classroom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "emulators": "firebase emulators:start --only firestore --project demo-techlith-inventory-session-7",
    "seed": "node scripts/seed.mjs",
    "start": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "typecheck": "tsc --noEmit",
