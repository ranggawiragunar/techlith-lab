    "regression": "node --test --test-reporter=tap tests/regression.test.mjs"
  },
  "dependencies": {
    "firebase": "^11.0.2",
    "firebase-admin": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.32.1",
    "typescript": "~5.7.2",
    "vite": "^6.4.1"
  }
}
