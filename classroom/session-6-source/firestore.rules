rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Session 6 local classroom emulator only. Never deploy these permissive rules.
    match /items/{itemId} {
      allow read, write: if request.auth == null;
    }
    match /stocktakings/{stocktakingId} {
      allow read, write: if request.auth == null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
