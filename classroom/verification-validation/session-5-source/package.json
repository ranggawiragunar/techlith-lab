{
  "name": "session-5-inventory-evaluation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage && node scripts/scoped-coverage.mjs",
    "mutation": "node scripts/run-mutation.mjs",
    "test:baseline": "vitest run tests/baseline",
    "coverage:baseline": "vitest run tests/baseline --coverage && node scripts/scoped-coverage.mjs",
    "mutation:baseline": "node scripts/run-mutation.mjs --baseline"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "~5.7.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.3"
  }
}
